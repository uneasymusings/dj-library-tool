        "idempotency_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
