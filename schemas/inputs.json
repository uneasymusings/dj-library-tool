    "OrganizationRequest": {
      "$defs": {
        "OrganizationFilters": {
          "additionalProperties": false,
          "properties": {
            "bpm_max": {
              "anyOf": [
                {
                  "maximum": 400,
                  "minimum": 20,
                  "type": "number"
                },
                {
                  "type": "null"
