          "type": "string"
        }
      },
      "required": [
        "name",
        "collection_ids",
        "workflow",
        "app_version"
      ],
      "title": "DeliveryRequest",
      "type": "object"
    },
    "DeliveryVerifyRequest": {
      "additionalProperties": false,
