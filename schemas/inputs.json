{
  "contracts": {
    "AnnotationRequest": {
      "$defs": {
        "BPMAnnotation": {
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "operator",
                "native_tag"
              ],
              "title": "Source",
              "type": "string"
            },
            "value": {
              "maximum": 400,
              "minimum": 20,
              "title": "Value",
              "type": "number"
            },
            "verified": {
              "default": false,
              "title": "Verified",
              "type": "boolean"
            }
          },
          "required": [
            "value",
            "source"
          ],
          "title": "BPMAnnotation",
          "type": "object"
        },
        "KeyAnnotation": {
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "operator",
                "native_tag"
              ],
              "title": "Source",
              "type": "string"
            },
            "value": {
              "maxLength": 32,
              "minLength": 1,
              "title": "Value",
              "type": "string"
            },
            "verified": {
              "default": false,
              "title": "Verified",
              "type": "boolean"
            }
          },
          "required": [
            "value",
            "source"
          ],
          "title": "KeyAnnotation",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Patch supplied fields only; null clears a field. Revision zero creates a row.",
      "properties": {
        "asset_revision_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Revision Id",
          "type": "string"
        },
        "bpm": {
          "anyOf": [
            {
              "$ref": "#/$defs/BPMAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "energy": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "genres": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Genres"
        },
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "recording_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Recording Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "set_role": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Set Role"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "required": [
        "recording_id",
        "asset_revision_id",
        "revision",
        "idempotency_key"
      ],
      "title": "AnnotationRequest",
      "type": "object"
    },
    "CollectionRequest": {
      "$defs": {
        "TrackInput": {
          "additionalProperties": false,
          "properties": {
            "artist": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Artist",
              "type": "string"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            },
            "title": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "version": {
              "default": "",
              "maxLength": 300,
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "path",
            "artist",
            "title"
          ],
          "title": "TrackInput",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "profile": {
          "default": "club",
          "title": "Profile",
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackInput"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "name",
        "tracks"
      ],
      "title": "CollectionRequest",
      "type": "object"
    },
    "ControlRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "pause",
            "resume",
            "cancel",
            "retry"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "ControlRequest",
      "type": "object"
    },
    "DeliveryDeviceRequest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "path"
      ],
      "title": "DeliveryDeviceRequest",
      "type": "object"
    },
    "DeliveryNativeXMLRequest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "path"
      ],
      "title": "DeliveryNativeXMLRequest",
      "type": "object"
    },
    "DeliveryObservation": {
      "additionalProperties": false,
      "properties": {
        "app_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "App Version",
          "type": "string"
        },
        "checked_recording_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Checked Recording Ids",
          "type": "array"
        },
        "firmware_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firmware Version"
        },
        "hardware_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Profile"
        },
        "method": {
          "enum": [
            "native_app_ui",
            "physical_hardware"
          ],
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "observer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Observer",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "playlist_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 100,
          "title": "Playlist Counts",
          "type": "object"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "imported",
            "analyzed",
            "native_exported",
            "device_library_checked",
            "hardware_playback"
          ],
          "title": "Stage",
          "type": "string"
        },
        "storage_recognized": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Recognized"
        },
        "track_count": {
          "minimum": 0,
          "title": "Track Count",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "stage",
        "app_version",
        "track_count",
        "playlist_counts",
        "checked_recording_ids",
        "observer",
        "notes",
        "method",
        "outcome"
      ],
      "title": "DeliveryObservation",
      "type": "object"
    },
    "DeliveryPrepareRequest": {
